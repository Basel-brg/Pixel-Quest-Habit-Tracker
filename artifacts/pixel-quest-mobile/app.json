{
  "expo": {
    "name": "Pixel Quest",
    "slug": "pixel-quest-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pixel-quest-mobile",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#161727",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Pixel Quest uses the camera to verify habit and quest completion.",
          "photosPermission": "Pixel Quest uses selected photos to verify habit and quest completion."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Pixel Quest uses the microphone to turn your spoken plan into tasks and habits."
        }
      ],
      "expo-notifications",
      "./plugins/with-reminder-clock.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
